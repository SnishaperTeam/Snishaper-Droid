<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same scope as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
