# Normalize line endings for cross-platform checkouts.
* text=auto eol=lf

# Windows scripts must stay CRLF.
*.bat text eol=crlf

# Shell / Gradle wrapper scripts must stay LF.
gradlew text eol=lf
*.sh text eol=lf

# Binaries.
*.aar binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.woff2 binary
*.so binary
*.dll binary
